# Copie para .env e preencha. O .env não é versionado.
# URL base de cada grupo de API do Xano: <URL da instância>/api:<canonical>
XANO_API_AUTH_URL=https://<instancia>.xano.io/api:bookingsystem-auth
XANO_API_UNIDADES_URL=https://<instancia>.xano.io/api:bookingsystem-unidades
XANO_API_CONTAS_URL=https://<instancia>.xano.io/api:bookingsystem-contas
XANO_API_ESPACOS_URL=https://<instancia>.xano.io/api:bookingsystem-espacos
XANO_API_RESERVAS_URL=https://<instancia>.xano.io/api:bookingsystem-reservas
